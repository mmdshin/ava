  "quizzes": [
    {
      "id": "sample-mixed",
      "title": "آزمون نمونه",
      "questions": [
        {
          "id": "sample-mixed-q01",
          "text": "کدام مورد برای پیشگیری از سقوط مناسب است؟",
          "options": [
            "پایین نگه داشتن نرده‌های تخت",
            "در دسترس گذاشتن زنگ احضار",
            "خاموش کردن همه چراغ‌ها",
            "محدود کردن مایعات"
          ],
          "correctIndex": 1,
          "explanation": "زنگ احضار در دسترس به بیمار کمک می‌کند بدون تلاش خطرناک کمک بخواهد.",
          "hint": "به ارتباط بیمار با پرستار فکر کنید."
        },
        {
          "id": "sample-mixed-q02",
          "text": "بهترین زمان وزن کردن بیمار با نارسایی قلبی کدام است؟",
          "options": [
            "هر زمان در دسترس بود",
            "روزانه در ساعت ثابت",
            "فقط هنگام ترخیص"
          ],
          "correctIndex": 1,
          "explanation": "وزن روزانه در ساعت ثابت تغییرات مایع بدن را بهتر نشان می‌دهد."
        },
        {
          "id": "sample-mixed-q03",
          "text": "شدت درد را با کدام ابزار می‌سنجیم؟",
          "options": [
            "مقیاس عددی 0 تا 10",
            "نبض رادیال",
            "دمای بدن"
          ],
          "correctIndex": 0,
          "explanation": "مقیاس عددی روشی ساده و رایج برای سنجش شدت درد است."
        }
      ]
    },
